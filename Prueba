-- Publicar datos del servidor en Firebase
local function PublicarDatosServidor()
    if not allowJoinActive then return end
    
    task.spawn(function()
        -- ✅ ASEGURAR que placeId sea número y jobId sea string
        local currentPlaceId = tonumber(game.PlaceId)
        local currentJobId = tostring(game.JobId)
        
        if not currentPlaceId or currentJobId == "" then
            warn("❌ No se pudo obtener PlaceId o JobId")
            return
        end
        
        local serverData = {
            username = player.Name,
            placeId = currentPlaceId,
            jobId = currentJobId,
            timestamp = os.time(),
            gameName = game:GetService("MarketplaceService"):GetProductInfo(currentPlaceId).Name or "Unknown"
        }
        
        local json = HttpService:JSONEncode(serverData)
        
        local success = pcall(function()
            request({
                Url = "https://jxnc-60014-default-rtdb.firebaseio.com/ServerJoinData/" .. player.Name .. ".json",
                Method = "PUT",
                Headers = { ["Content-Type"] = "application/json" },
                Body = json
            })
        end)
        
        if success then
            print("✅ Datos de servidor publicados - PlaceId:", currentPlaceId, "JobId:", currentJobId)
        else
            warn("❌ Error al publicar datos del servidor")
        end
    end)
end





-- Limpiar datos del servidor cuando se desactive
local function LimpiarDatosServidor()
    for intento = 1, 3 do
        local success = pcall(function()
            request({
                Url = "https://jxnc-60014-default-rtdb.firebaseio.com/ServerJoinData/" .. player.Name .. ".json",
                Method = "DELETE"
            })
        end)
        if success then
            print("✅ ServerJoinData eliminado (intento " .. intento .. ")")
            break
        else
            warn("⚠️ Intento " .. intento .. " fallido al eliminar ServerJoinData")
            if intento < 3 then task.wait(1) end
        end
    end
end
-- Activar toggle de unirse (3 minutos)
local function ActivarAllowJoin()
    if allowJoinActive then return end
    
    allowJoinActive = true
    
    -- Publicar datos inmediatamente
    PublicarDatosServidor()
    
    -- ✅ CORREGIDO: Variable única para el loop de actualización
    local updateLoop = task.spawn(function()
        while allowJoinActive do
            task.wait(30)
            if allowJoinActive then
                PublicarDatosServidor()
            end
        end
    end)
    
    -- Actualizar UI del botón
    if allowJoinToggleBtn then
        allowJoinToggleBtn.BackgroundColor3 = Color3.fromRGB(67, 181, 129)
        allowJoinToggleBtn.Text = "✅"
        
        -- Animación de pulso
        task.spawn(function()
            while allowJoinActive and allowJoinToggleBtn and allowJoinToggleBtn.Parent do
                TweenService:Create(allowJoinToggleBtn, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
                    BackgroundColor3 = Color3.fromRGB(87, 201, 149)
                }):Play()
                task.wait(0.8)
            end
        end)
    end
    
    -- Desactivar después de 3 minutos
    if joinTimerConnection then
        task.cancel(joinTimerConnection)
    end
    
    joinTimerConnection = task.delay(180, function() -- 3 minutos = 180 segundos
        print("⏰ Tiempo de unirse expirado - Desactivando...")
        DesactivarAllowJoin()
    end)
    
    print("✅ Toggle de unirse ACTIVADO por 3 minutos")
end

-- Desactivar toggle de unirse
function DesactivarAllowJoin()
    if not allowJoinActive then return end

    print("🧹 Limpiando datos del servidor ANTES de desactivar flag...")

    -- ✅ Limpiar PRIMERO antes de poner allowJoinActive = false
    -- así el cleanup al salir nunca pierde datos huérfanos
    local cleanupDone = false
    task.spawn(function()
        LimpiarDatosServidor()
        cleanupDone = true
    end)

    -- Esperar máximo 3 segundos
    local timeout = 0
    repeat
        task.wait(0.1)
        timeout = timeout + 0.1
    until cleanupDone or timeout >= 3

    if not cleanupDone then
        warn("⚠️ Timeout limpiando datos - puede quedar residual en Firebase")
    end

    -- Ahora sí desactivar el flag
    allowJoinActive = false

    -- Actualizar UI del botón
    if allowJoinToggleBtn and allowJoinToggleBtn.Parent then
        allowJoinToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
        allowJoinToggleBtn.Text = "🔗"
    end

    -- Cancelar timer
    if joinTimerConnection then
        task.cancel(joinTimerConnection)
        joinTimerConnection = nil
    end

    print("❌ Toggle de unirse DESACTIVADO y datos limpiados")
end


-- Obtener datos de servidor de un usuario específico
local function ObtenerDatosServidorUsuario(username)
    local success, response = pcall(function()
        return request({
            Url = "https://jxnc-60014-default-rtdb.firebaseio.com/ServerJoinData/" .. username .. ".json",
            Method = "GET"
        })
    end)
    
    if success and response and response.Body then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        
        if ok and typeof(data) == "table" then
            -- Verificar que los datos no sean muy viejos (más de 3.5 minutos)
            local currentTime = os.time()
            if data.timestamp and (currentTime - data.timestamp) <= 210 then -- 3.5 minutos
                return data
            end
        end
    end
    
    return nil
end


