-- Publicar datos del servidor en Firebase
local function PublicarDatosServidor()
    if not allowJoinActive then return end
    
task.spawn(function()
        if not allowJoinActive then return end  -- check dentro del spawn
        local currentPlaceId = tonumber(game.PlaceId)
        local currentJobId = tostring(game.JobId)
        
        if not currentPlaceId or currentJobId == "" then
            warn("❌ No se pudo obtener PlaceId o JobId")
            return
        end
        
        local serverData = {
            username = player.Name,
            placeId = currentPlaceId,
            jobId = currentJobId,
            timestamp = os.time(),
            gameName = game:GetService("MarketplaceService"):GetProductInfo(currentPlaceId).Name or "Unknown"
        }
        
        local json = HttpService:JSONEncode(serverData)
        
        local success = pcall(function()
            request({
                Url = "https://jxnc-60014-default-rtdb.firebaseio.com/ServerJoinData/" .. player.Name .. ".json",
                Method = "PUT",
                Headers = { ["Content-Type"] = "application/json" },
                Body = json
            })
        end)
        
        if success then
            print("✅ Datos de servidor publicados - PlaceId:", currentPlaceId, "JobId:", currentJobId)
        else
            warn("❌ Error al publicar datos del servidor")
        end
    end)
end





-- Limpiar datos del servidor cuando se desactive
local function LimpiarDatosServidor()
    for intento = 1, 3 do
        local success = pcall(function()
            request({
                Url = "https://jxnc-60014-default-rtdb.firebaseio.com/ServerJoinData/" .. player.Name .. ".json",
                Method = "DELETE"
            })
        end)
        if success then
            print("✅ ServerJoinData eliminado (intento " .. intento .. ")")
            break
        else
            warn("⚠️ Intento " .. intento .. " fallido al eliminar ServerJoinData")
            if intento < 3 then task.wait(1) end
        end
    end
end
