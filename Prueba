-- tipo: "mute" (extra = minutos), "blockimages", "ban"
local function AplicarSancion(username, tipo, extra, reason)
    username = username:gsub("^%s*(.-)%s*$", "%1")
    if username == "" then return false, "Nombre vacío" end
    reason = (reason or ""):gsub("^%s*(.-)%s*$", "%1")
 
    local existente = sancionesData[username] or {}
    local nueva = {
        banned = existente.banned or false,
        muteUntil = existente.muteUntil,
        blockImages = existente.blockImages or false,
        reason = (reason ~= "" and reason) or existente.reason or "",
        moderator = player.Name,
        timestamp = os.time(),
    }
 
    if tipo == "mute" then
        nueva.muteUntil = os.time() + (extra * 60)
    elseif tipo == "blockimages" then
        nueva.blockImages = true
    elseif tipo == "ban" then
        nueva.banned = true
    end
 
    GuardarSancion(username, nueva)
    return true
end
 
