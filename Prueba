local function CargarStickers()
    if not isfile or not isfile("JXNULL_CONFIGS/Stickers.json") then
        return {}
    end
    
    local contenido = readfile("JXNULL_CONFIGS/Stickers.json")
    if contenido and contenido ~= "" then
        local success, datos = pcall(function()
            return HttpService:JSONDecode(contenido)
        end)
        
        if success and typeof(datos) == "table" then
            return datos
        end
    end
    
    return {}
end

local function GuardarStickers(stickers)
    if writefile then
        local json = HttpService:JSONEncode(stickers)
        writefile("JXNULL_CONFIGS/Stickers.json", json)
    end
end

local function DetectarURLImagen(texto)
    texto = texto:gsub("^%s*(.-)%s*$", "%1")
    
    if texto:match("^%d+$") and #texto >= 5 then
        return "rbxassetid://" .. texto
    end
    
    if texto:find("rbxassetid://") then
        local id = texto:match("rbxassetid://(%d+)")
        if id then return "rbxassetid://" .. id end
    end
    
    if texto:find("roblox%.com/asset/") then
        local id = texto:match("/asset/(%d+)")
        if id then return "rbxassetid://" .. id end
    end
    
    if texto:find("roblox%.com/asset/%?id=") then
        local id = texto:match("id=(%d+)")
        if id then return "rbxassetid://" .. id end
    end
    
    if texto:find("roblox%.com/library/") then
        local id = texto:match("/library/(%d+)")
        if id then return "rbxassetid://" .. id end
    end
    
if texto:find("cdn%.discordapp%.com") or texto:find("media%.discordapp%.net") then
    local url = texto:match("https?://[%S]+")
    if url then return url end
end
    
    if texto:find("%.rbxcdn%.com") then
        local url = texto:match("https?://[%w%.%-_]+%.rbxcdn%.com/[%w%.%-_/]+")
        if url then return url end
    end
    
    if texto:find("%.png") or texto:find("%.jpg") or texto:find("%.jpeg") or 
       texto:find("%.gif") or texto:find("%.webp") then
        local url = texto:match("https?://[%S]+%.%a+")
        if url then return url end
    end
    
    if texto:find("i%.ibb%.co") or texto:find("imgur%.com") then
        local url = texto:match("https?://[%S]+")
        if url then return url end
    end
    
    return nil
end

local function ExtraerTextoSinURL(texto, urlImagen)
    if not urlImagen then return texto end
    
    local textoLimpio = texto:gsub(urlImagen, "")
    
    if urlImagen:find("rbxassetid://") then
        local id = urlImagen:match("rbxassetid://(%d+)")
        if id then
            textoLimpio = textoLimpio:gsub("rbxassetid://" .. id, "")
            textoLimpio = textoLimpio:gsub(id, "")
        end
    end
    
    textoLimpio = textoLimpio:gsub("^%s*(.-)%s*$", "%1")
    
    return textoLimpio
end

local function AgregarSticker(url, nombre)
    nombre = nombre or ("Sticker_" .. #stickersGuardados + 1)
    
    for _, sticker in ipairs(stickersGuardados) do
        if sticker.url == url then
            return false, "Ya existe"
        end
    end
    
    table.insert(stickersGuardados, {
        url = url,
        nombre = nombre,
        timestamp = os.time()
    })
    
    GuardarStickers(stickersGuardados)
    return true, "Guardado"
end

local function EliminarSticker(index)
    if stickersGuardados[index] then
        table.remove(stickersGuardados, index)
        GuardarStickers(stickersGuardados)
        return true
    end
    return false
end

