-- FUNCIÓN: MOSTRAR MENSAJES
local function showMessages(data)
    if not chatBox then return end

    -- ✅ NUEVO: Prevenir procesamiento simultáneo
    if _G.CHAT_PROCESANDO_MENSAJES then
        return
    end
    _G.CHAT_PROCESANDO_MENSAJES = true

    local mensajes = {}
    for key, value in pairs(data or {}) do
        value._id = key
        table.insert(mensajes, value)
    end

    table.sort(mensajes, function(a, b)
        if a.time == b.time then
            return (a._id or "") < (b._id or "")
        end
        return (a.time or 0) < (b.time or 0)
    end)

    local estoyAlFinal = primeraVez
    
    if not primeraVez and chatBox.AbsoluteCanvasSize.Y > 0 then
        local posicionActual = chatBox.CanvasPosition.Y
        local alturaVentana = chatBox.AbsoluteWindowSize.Y
        local alturaTotal = chatBox.AbsoluteCanvasSize.Y
        estoyAlFinal = (posicionActual + alturaVentana) >= (alturaTotal - 20)
    end

local mensajesNuevos = {}
    for _, msg in ipairs(mensajes) do
        -- ✅ VERIFICACIÓN MEJORADA: Revisar si ya existe visualmente
        if not mensajesMostrados[msg._id] and not chatBox:FindFirstChild("MessageContainer_" .. msg._id) then
            table.insert(mensajesNuevos, msg)
        end
    end

    -- ✅ NUEVO: Si no hay mensajes nuevos, liberar y salir
    if #mensajesNuevos == 0 then
        _G.CHAT_PROCESANDO_MENSAJES = false
        return
    end

    for _, msg in ipairs(mensajesNuevos) do
        local messageId = msg._id
        mensajesMostrados[messageId] = true

        local username = tostring(msg.username or "???")
        local text = tostring(msg.text or "")
        
        local urlImagen = DetectarURLImagen(text)
        local esSticker = urlImagen ~= nil
        
