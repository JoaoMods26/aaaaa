        if input.UserInputType == Enum.UserInputType.MouseButton1 or 
           input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    
                    if frame and frame.Parent then
                        local viewport = workspace.CurrentCamera.ViewportSize
                        local newConfig = CargarConfiguracion()
                        
                        -- ✅ GUARDAR POSICIÓN VALIDADA (0-0.95)
                        local posXNormalized = frame.Position.X.Offset / viewport.X
                        local posYNormalized = frame.Position.Y.Offset / viewport.Y
                        
                        newConfig.PosicionX = math.clamp(posXNormalized, 0, 0.95)
                        newConfig.PosicionY = math.clamp(posYNormalized, 0, 0.95)
                        
                        GuardarConfiguracion(newConfig)
                    end
                end
            end)
        end
    end)

