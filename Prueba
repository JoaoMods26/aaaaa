local function CargarImagenEnSticker(stickerImage, urlImagen)
    -- ✅ IDs de Roblox: siempre se cargan, no requieren descarga a disco
    if urlImagen:match("^rbxassetid://") then
        stickerImage.Image = urlImagen
        return
    end

    -- Si no es un link http(s) válido, no hacemos nada
    if not urlImagen:match("^https?://") then
        stickerImage.Image = ""
        return
    end

    -- Calcular el nombre de archivo asociado a esta URL
    local urlHash = 0
    for i = 1, #urlImagen do
        urlHash = (urlHash * 31 + string.byte(urlImagen, i)) % 99999999
    end
    local fileName = IMG_FOLDER .. "jxstk_" .. urlHash .. ".png"

