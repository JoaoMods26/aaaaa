-- Chequea si el jugador LOCAL puede enviar un mensaje ahora mismo.
-- Devuelve true si puede, false si está bloqueado (y ya mostró el aviso).
local function VerificarSancionPropia()
    local sancion = sancionesData[player.Name]
    if not sancion then return true end
 
    if sancion.banned then
        textBox.PlaceholderText = "⛔ Baneado del chat" .. (sancion.reason ~= "" and (" — " .. sancion.reason) or "")
        textBox.PlaceholderColor3 = Color3.fromRGB(255, 80, 80)
        task.spawn(function()
            task.wait(2.5)
            if textBox and textBox.Parent then
                textBox.PlaceholderText = "💬 Escribe mensaje o pega URL de imagen..."
                textBox.PlaceholderColor3 = Color3.fromRGB(120, 120, 130)
            end
        end)
        return false
    end
 
    if sancion.muteUntil and sancion.muteUntil > os.time() then
        local mins = math.ceil((sancion.muteUntil - os.time()) / 60)
        textBox.PlaceholderText = "🔇 Muteado (" .. mins .. "m)" .. (sancion.reason ~= "" and (" — " .. sancion.reason) or "")
        textBox.PlaceholderColor3 = Color3.fromRGB(255, 193, 7)
        task.spawn(function()
            task.wait(2.5)
            if textBox and textBox.Parent then
                textBox.PlaceholderText = "💬 Escribe mensaje o pega URL de imagen..."
                textBox.PlaceholderColor3 = Color3.fromRGB(120, 120, 130)
            end
        end)
        return false
    end
 
    return true
end
 




