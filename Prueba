-- ── LÓGICA: RESOLVER URL ──────────────────────────
 local function ResolverURL(rawUrl)
    rawUrl = rawUrl:gsub("^%s*(.-)%s*$", "%1")
    if rawUrl == "" then return nil, "URL vacía" end

    if rawUrl:match("^rbxassetid://") then
        return rawUrl, nil
    end

    if rawUrl:match("^%d+$") and #rawUrl >= 5 then
        return "rbxassetid://" .. rawUrl, nil
    end

    if rawUrl:match("^https?://") then
        -- Hash para evitar duplicados
        local urlHash = 0
        for i = 1, #rawUrl do
            urlHash = (urlHash * 31 + string.byte(rawUrl, i)) % 99999999
        end
        -- ✅ Ruta simple sin subcarpeta
        local fileName = "jxstk_" .. urlHash .. ".png"

        local ok = pcall(function()
            if not isfile(fileName) then
                writefile(fileName, game:HttpGet(rawUrl))
            end
        end)

        if not ok then
            return nil, "No se pudo descargar"
        end

        -- ✅ getcustomasset fuera de pcall, como en el ejemplo
        local assetUrl = getcustomasset(fileName)
        if not assetUrl or assetUrl == "" then
            return nil, "Error al cargar imagen"
        end

        return assetUrl, nil, fileName
    end

    return nil, "Formato no reconocido"
end
