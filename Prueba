local function EnviarNotificacionRespuesta(targetUsername, responderUsername, mensaje)
    task.spawn(function()
        local notificationData = {
            target_user = targetUsername,
            responder = responderUsername,
            message = mensaje,
            time = os.time(),
            read = false
        }
        
        local json = HttpService:JSONEncode(notificationData)
        
        pcall(function()
            request({
                Url = respuestasURL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = json
            })
        end)
    end)
end

local function VerificarNotificaciones()
    task.spawn(function()
        while escuchaActiva do
            local success, response = pcall(function()
                return request({ 
                    Url = respuestasURL, 
                    Method = "GET" 
                })
            end)

            if success and response and response.Body then
                local ok, notificaciones = pcall(function()
                    return HttpService:JSONDecode(response.Body)
                end)

                if ok and typeof(notificaciones) == "table" then
                    for notifId, notif in pairs(notificaciones) do
                        if notif.target_user == player.Name and not notif.read then
                            if _G.Rayfield and _G.Rayfield.Notify then
                                _G.Rayfield:Notify({
                                    Title = "💬 " .. notif.responder .. " te respondió",
                                    Content = notif.message:sub(1, 50) .. (notif.message:len() > 50 and "..." or ""),
                                    Duration = 5,
                                    Image = 4483362458
                                })
                            end
                            
                            pcall(function()
                                request({
                                    Url = "https://chatsitouwu-xd-xd-default-rtdb.firebaseio.com/Respuestas/" .. notifId .. ".json",
                                    Method = "DELETE"
                                })
                            end)
                        end
                    end
                end
            end

            task.wait(3)
        end
    end)
end

