-- SISTEMA DE CONFIGURACIÓN
local function CargarConfiguracion()
    local defaultConfig = {
        Transparency = 0,
        ImageId = "",
        PosicionX = 0.05,
        PosicionY = 0.3,
        PermitirDescargaImagenes = false -- 🆕 Por defecto desactivado
    }
    
    if not isfile or not isfile("JXNULL_CONFIGS/Config.json") then
        return defaultConfig
    end
    
    local contenido = readfile("JXNULL_CONFIGS/Config.json")
    if contenido and contenido ~= "" then
        local success, datos = pcall(function()
            return HttpService:JSONDecode(contenido)
        end)
        
        if success and typeof(datos) == "table" then
            -- ✅ VALIDACIÓN ESTRICTA: Solo valores entre 0 y 1 son seguros
            if datos.PosicionX then
                datos.PosicionX = math.clamp(datos.PosicionX, 0, 0.95)
            else
                datos.PosicionX = defaultConfig.PosicionX
            end
            
            if datos.PosicionY then
                datos.PosicionY = math.clamp(datos.PosicionY, 0, 0.95)
            else
                datos.PosicionY = defaultConfig.PosicionY
            end
            
-- ✅ Asegurar que otros valores existan
            datos.Transparency = datos.Transparency or defaultConfig.Transparency
            datos.ImageId = datos.ImageId or defaultConfig.ImageId
            datos.PermitirDescargaImagenes = datos.PermitirDescargaImagenes or defaultConfig.PermitirDescargaImagenes
            
            return datos
        end
    end
    
    return defaultConfig
end

local function GuardarConfiguracion(datos)
    if writefile then
        -- ✅ VALIDACIÓN ESTRICTA al guardar: Solo 0-0.95 para evitar que salga de pantalla
        if datos.PosicionX then
            datos.PosicionX = math.clamp(datos.PosicionX, 0, 0.95)
        end
        if datos.PosicionY then
            datos.PosicionY = math.clamp(datos.PosicionY, 0, 0.95)
        end
        
local json = HttpService:JSONEncode(datos)
        writefile("JXNULL_CONFIGS/Config.json", json)
    end
end

